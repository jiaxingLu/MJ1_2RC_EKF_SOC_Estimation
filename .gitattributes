# Automatic text detection
* text=auto

# Text files: store with Unix LF in Git
*.m   text eol=lf
*.md  text eol=lf
*.csv text eol=lf
*.txt text eol=lf

# Binary MATLAB / Simulink files
*.mat binary
*.slx binary

# Figures / documents
*.png binary
*.jpg binary
*.jpeg binary
*.pdf binary

# Repository configuration files
*.json text eol=lf
.gitignore text eol=lf
.gitattributes text eol=lf
*.cff text eol=lf

# A8c archived CSV bytes are hashed; preserve their original line endings.
results/validation/A8c/*.csv -text -eol whitespace=blank-at-eol,blank-at-eof,space-before-tab,cr-at-eol
tools/verify_a8c_evidence.py text eol=lf

# EXT1 archived evidence bytes are SHA-256 locked; preserve original line endings.
results/extension_track1/*.csv -text -eol
results/extension_track1/*.txt -text -eol
